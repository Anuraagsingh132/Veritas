<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64" fill="none">
  <defs>
    <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366f1" />
      <stop offset="50%" stop-color="#8b5cf6" />
      <stop offset="100%" stop-color="#06b6d4" />
    </linearGradient>
    <linearGradient id="g2" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#3b82f6" />
      <stop offset="100%" stop-color="#10b981" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#6366f1" flood-opacity="0.4" />
    </filter>
  </defs>
  
  <!-- Outer Rounded Shield / Nexus Base -->
  <rect x="4" y="4" width="56" height="56" rx="16" fill="#090d16" stroke="url(#g1)" stroke-width="2.5" />
  
  <!-- Layer 1: Bottom Grounding Plane -->
  <path d="M16 38 L32 46 L48 38 L32 30 Z" fill="url(#g2)" opacity="0.35" />
  
  <!-- Layer 2: Middle Reconciled Knowledge Plane -->
  <path d="M16 28 L32 36 L48 28 L32 20 Z" fill="url(#g1)" opacity="0.65" />
  
  <!-- Layer 3: Top Ground-Truth Focal Prism -->
  <path d="M18 19 L32 26 L46 19 L32 12 Z" fill="url(#g1)" filter="url(#glow)" />
  
  <!-- Central Verification Node / Keystone Core -->
  <circle cx="32" cy="26" r="4.5" fill="#38bdf8" stroke="#ffffff" stroke-width="2" />
  <circle cx="20" cy="33" r="2.5" fill="#818cf8" />
  <circle cx="44" cy="33" r="2.5" fill="#34d399" />
  <circle cx="32" cy="41" r="2.5" fill="#a78bfa" />
  
  <!-- Connecting Epistemic Edges -->
  <line x1="32" y1="26" x2="20" y2="33" stroke="#818cf8" stroke-width="1.5" stroke-dasharray="2 1" opacity="0.8" />
  <line x1="32" y1="26" x2="44" y2="33" stroke="#34d399" stroke-width="1.5" stroke-dasharray="2 1" opacity="0.8" />
  <line x1="20" y1="33" x2="32" y2="41" stroke="#a78bfa" stroke-width="1.5" opacity="0.7" />
  <line x1="44" y1="33" x2="32" y2="41" stroke="#a78bfa" stroke-width="1.5" opacity="0.7" />
</svg>